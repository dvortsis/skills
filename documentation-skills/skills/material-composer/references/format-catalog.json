{
 "version": "1.0.0",
 "renderers": {
  "doc-sheet": {
   "skill": "document-builder",
   "build": "scripts/build_doc.py <doc.json> --out <Name>.docx --pdf",
   "gate": "scripts/lint_doc.py <doc.json> --docx <Name>.docx --pdf <Name>.pdf",
   "note": "meta.layout sheet; meta.doc_type from the format"
  },
  "doc-long": {
   "skill": "document-builder",
   "build": "scripts/build_doc.py <doc.json> --out <Name>.docx --pdf",
   "gate": "scripts/lint_doc.py <doc.json> --docx <Name>.docx --pdf <Name>.pdf"
  },
  "deck": {
   "skill": "slide-deck",
   "build": "scripts/build_deck.py <deck.json> --out <Name>.pptx",
   "gate": "scripts/lint_deck.py <deck.json> --pptx <Name>.pptx"
  },
  "page": {
   "skill": "confluence-page-builder",
   "build": "scripts/build_page.py <page.json>",
   "gate": "scripts/lint_page.py <page.json>"
  },
  "training-md": {
   "skill": "training-material-designer",
   "build": "(Markdown is the deliverable; output: pdf converts with scripts/md_to_sheet.py)",
   "gate": "scripts/lint_training.py <file>.md"
  },
  "md": {
   "skill": "material-composer",
   "build": "(Markdown is the deliverable; send as .email or .message when asked)",
   "gate": "scripts/lint_material.py <file>.md --plan <plan.json>"
  },
  "form": {
   "skill": "material-composer",
   "build": "scripts/build_form.py <form.json> --out <Name>",
   "gate": "scripts/build_form.py <form.json> --check"
  },
  "module": {
   "skill": "material-composer",
   "build": "scripts/build_module.py <module.json> --out <Name>",
   "gate": "(runs before build)"
  },
  "xlsx": {
   "skill": "material-composer",
   "build": "scripts/build_sheet.py <sheet.json> --out <Name>",
   "gate": "scripts/build_sheet.py <Name>.xlsx --check"
  }
 },
