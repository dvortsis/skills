{
 "placeholders": ["\\bTBD\\b", "\\bTODO\\b", "First Last", "lorem ipsum", "\\[insert", "XX/XX", "<name>"],
 "filler": ["leverage", "unlock", "seamless", "seamlessly", "robust", "empower", "deep dive", "synergy", "game-changer", "cutting-edge", "best-in-class", "world-class"],
 "slop_openers": ["this document will", "this email will", "exciting news", "we are thrilled", "we're thrilled", "i hope this email finds you well", "i hope this finds you well", "in today's fast-paced"],
 "phi_patterns": {"a Social Security number": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "a medical record number": "\\bMRN[:#]?\\s*\\d{4,}", "a date of birth": "\\b(DOB|date of birth)\\b\\s*[:=]?\\s*\\d"},
 "adkar": ["awareness", "desire", "knowledge", "ability", "reinforcement"],
 "kit_message_pieces": ["announcement-email", "manager-talking-points", "chat-post", "reminder-email", "newsletter-article"],
 "kit_adoption": {"piece": "adoption-measures", "stage": "reinforcement", "fields": ["measure", "source", "review_date"],
                  "fields_md": {"measure": ["What We Measure", "Measure"], "source": ["Where It Comes From", "Source"], "review_date": ["Review Date"]},
                  "target_md": ["Target"], "target_source_md": ["Target Source"],
                  "missing": "kit has no adoption-measures piece (reinforcement stage): what is measured, where it comes from, review date"},
 "kit_must_say": {"why": ["Why This Is Changing", "Why We Are Changing", "Why It Matters", "Key Message"], "impact": ["What Changes for You", "What Changes for Your Team", "What It Means for You", "What Changes"], "ask": ["What to Do", "What to Ask Your Team to Do", "Your Next Step", "Next Steps"]},
 "match": {"low_below": 1.0, "question": "Is this closer to a one-pager, a reference table or a long document?",
           "neutral_anatomy": [{"title": "Purpose", "required": true}, {"title": "Key Points", "required": true}, {"title": "What to Do", "required": true}, {"title": "Get Help", "required": true}],
           "family_default": {"long-form": "sop"}},
 "renderer_gates": {"doc-sheet": ["ANATOMY_MATCH", "QS_STRUCTURE or SHEET_PAGE_FIT", "FIG_TEXT_SIZE (8 pt)"],
                    "doc-long": ["required sections (lint_doc)", "textbook profile for guides and manuals"],
                    "deck": ["lint_deck", "ILT_PAIR when paired with a facilitator guide"],
                    "page": ["lint_page"],
                    "training-md": ["lint_training (Answer and Why per question)", "ILT_PAIR for facilitator guides"],
                    "md": ["ANATOMY_MATCH", "SLOP_OPENER", "SUBJECT_LENGTH", "KIT_COVERAGE and KIT_ADOPTION for kits", "COMMS_CHECK for communication formats"],
                    "form": ["SURVEY_ITEM", "FORM_FIELD", "FORM_FIELDS_MATCH"],
                    "module": ["ELEARN_INTERACTION", "ELEARN_OBJECTIVE", "ELEARN_OFFLINE"],
                    "xlsx": ["XLSX_TABLE (build_sheet.py <Name>.xlsx --check)"]},
 "extra_outputs": {"about": "D-53: formats that also plan an Excel table (output: renderer); the main BUILD line is unchanged", "data-dictionary": {"xlsx": "xlsx"}, "raci": {"xlsx": "xlsx"}},
 "sheet": {"about": "scripts/build_sheet.py (D-53)", "status_headers": ["status", "state"], "lists_tab": "Lists", "lists_hidden": true, "definitions_tab": "Definitions",
           "tab_labels": {"tracker": "Tracker", "data-dictionary": "Data Dictionary", "raci": "RACI"}, "table_style": "TableStyleLight1",
           "header_fill": "dark", "header_text": "white", "max_width": 60, "validate_rows": 500,
           "definitions_header": ["Term", "Kind", "List", "Definition"], "about_keys": ["title", "version", "date", "owner_role", "sources"]},
 "comms_kinds": {"announcement-email": "email", "chat-post": "teams", "manager-talking-points": "talking-points", "memo": "memo", "proposal": "proposal", "meeting-recap": "recap"},
 "translation": {"budget": 0.75,
                 "rules": ["about 25 percent spare space for text growth", "no idioms, slang or culture-specific references", "short sentences, one idea each", "all text in the document, none in images"],
                 "process": "your organization's written translation process: ask the approved translation vendor for an estimate, approve the estimate, then raise the purchase order",
                 "never": "Written translation only, never machine translation"},
 "format_rules": {
  "about": "lint_material.py format_rules(): run on a .md piece by its front matter format (or --plan format) and on a doc.json by --plan format, else meta.format or meta.doc_type; a derived format uses the rules of the format it borrows from. A section is found by title: Markdown ## headings; doc.json sections and sheet subsections at any depth. A section's table is its first pipe table (Markdown) or table block (doc.json columns + rows, subsections included). A column is the first header (after the first) containing one of the listed words; the first column names the row (activity, topic, metric, field, audience). Group labels are ### headings, bold-only lines and doc.json subsection titles. List items are Markdown - or 1. lines or doc.json bullets, numbered and procedure blocks. A skills-check-off criterion is a Markdown list item or first table cell, or a form item label in a doc.json form (skip_types skipped). A blank cell is one of blank_cells; a date matches date_patterns. Words in lists match whole words, case-insensitive.",
  "date_patterns": ["\\b\\d{4}-\\d{2}-\\d{2}\\b", "\\b\\d{1,2}/\\d{1,2}/\\d{2,4}\\b", "\\b(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[a-z]*\\.?\\s+\\d{1,2}\\b"],
  "blank_cells": ["", "-", "--", "\u2014", "\u2013", "n/a", "na", "none", "?", "tbd"],
  "formats": {
   "raci": {"section": "RACI Matrix", "letters": {"R": ["r", "responsible"], "A": ["a", "accountable"], "C": ["c", "consulted"], "I": ["i", "informed"]},
            "gate": "RACI_ONE_A (exactly one A and at least one R per activity)"},
   "meeting-agenda": {"section": "Agenda", "minutes_headers": ["min", "duration"], "owner_headers": ["owner"], "total_labels": ["total", "totals"],
                      "length_meta": "duration_min", "length_sections": ["Purpose"], "length_pattern": "\\b(\\d{1,3})[- ]minute\\b",
                      "gate": "AGENDA_TIME (topic minutes add up to duration_min or the 'NN-minute' length in the title or Purpose; an owner role per topic)"},
   "metric-definitions": {"section": "Metric Definitions",
                          "fields": {"definition": ["definition"], "formula": ["formula", "calculation"], "source": ["source"], "refresh": ["refresh"], "owner role": ["owner"]},
                          "gate": "METRIC_FIELDS (definition, formula, source, refresh and owner role per metric)"},
   "data-dictionary": {"section": "Fields", "fields": {"description": ["description"], "data type": ["type"], "source": ["source"]},
                       "classification": ["classification"], "phi_flag": ["phi"], "phi_classes": ["phi", "protected health"], "not_phi": ["non-phi", "non phi", "not phi", "no phi"],
                       "flag_yes": ["yes", "y", "true", "x", "\u2713", "\u2714", "phi", "flagged"], "example": ["example"],
                       "example_patterns": {"a phone number": "(\\(\\d{3}\\)\\s?|\\b\\d{3}[-.\\s])\\d{3}[-.\\s]\\d{4}\\b", "an email address": "\\b[\\w.+-]+@[\\w-]+\\.[\\w.-]+\\b"},
                       "gate": "DICT_FIELDS (description, data type, source; PHI-classified fields flagged); PHI_PATTERN on examples"},
   "release-notes": {"section": "What Changed", "groups": ["New", "Changed", "Fixed", "Removed"], "group_headers": ["type", "category", "group"],
                     "affected_section": "Who Is Affected", "not_affected": ["no one", "nobody", "no users", "not affected", "none"], "action_section": "Action Needed",
                     "gate": "RELEASE_ACTION (What Changed grouped New, Changed, Fixed, Removed; Action Needed dated when users are affected)"},
   "proposal": {"first_words": 150, "ask_terms": ["approve", "approves", "approval", "decide", "decision", "fund", "funding", "request", "requests", "ask", "endorse", "sign off"],
                "options_section": "Options Considered", "min_options": 2,
                "gate": "PROPOSAL_ASK (the ask and decision date in the first 150 words; at least 2 options)"},
   "process-map": {"section": "Steps in Order", "min_steps": 2, "gate": "PROCESS_TEXT (numbered text version of the map in Steps in Order)"},
   "skills-check-off": {"verbs_file": "elearning_rules.json", "verbs_key": "non_observable_verbs", "examples": "demonstrates, completes, enters",
                        "lead_ins": ["the learner", "learner", "the team member", "team member", "the employee", "employee", "the participant", "participant", "can"], "skip_types": ["signature", "date"],
                        "gate": "CHECKOFF_VERBS (each criterion starts with an observable verb)"},
   "project-charter": {"goal_section": "Goals and Measures", "scope_section": "Scope", "out_labels": ["out of scope", "out-of-scope", "not in scope"],
                       "measurable": ["\\d", "(?i)\\b(one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|fifteen|twenty|thirty|forty|fifty|hundred|half|double|percent)\\b",
                                      "\\b(January|February|March|April|May|June|July|August|September|October|November|December)\\b", "\\bQ[1-4]\\b"],
                       "gate": "CHARTER_GOAL warn (measurable goal; out-of-scope items listed)"},
   "training-plan": {"audience_section": "Audiences", "map_section": "Curriculum Map", "audience_headers": ["audience", "who"], "all_words": ["all", "everyone", "all audiences", "all roles"],
                     "gate": "PLAN_COVERAGE warn (every audience has a module in the Curriculum Map)"},
   "dashboard-guide": {"definitions_section": "Definitions", "max_words": 4,
                       "metric_suffixes": ["Rate", "Ratio", "Percent", "Percentage", "Count", "Yield", "Backlog", "Volume", "Index", "Score", "Average"],
                       "stop_words": ["The", "A", "An", "Our", "Your", "This", "That", "Each", "Every", "Use", "See", "Open", "Check", "Find", "Select", "Filter", "View", "In", "On", "For", "From", "When", "If", "Then", "To", "And"],
                       "gate": "DASH_DEFS warn (every metric named is defined in Definitions)"}
  }
 }
}

